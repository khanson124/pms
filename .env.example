# Database Configuration
DATABASE_URL="mysql://user:password@host:3306/database_name"

# Backend Configuration
PORT=4000
JWT_SECRET="change-this-to-a-random-secret-in-production"
APP_ENV=development
API_HOST=0.0.0.0
API_PUBLIC_HOST=localhost

# CORS Configuration
# Frontend URL for CORS (must match frontend origin exactly when using cookie auth)
CORS_ORIGIN=http://localhost:5173
# Alternative: FRONTEND_URL=http://localhost:5173

# Frontend API URL (for Vite build)
# VITE_API_URL=http://localhost:4000

# Azure AD Authentication (Optional)
# AZURE_CLIENT_ID="your-client-id"
# AZURE_TENANT_ID="your-tenant-id"
# AZURE_REDIRECT_URI="http://localhost:5173/auth/callback"

# Redis Cache (Optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Session & Security
SESSION_SECRET="change-this-to-a-random-secret-in-production"
NODE_ENV=development
LOG_LEVEL=info

# LDAP Authentication (Optional - for Active Directory integration)
# LDAP_URL=ldap://your-domain.local:389
# LDAP_BIND_DN=CN=ServiceAccount,OU=Users,DC=your-domain,DC=local
# LDAP_BIND_PASSWORD=your-service-account-password
# LDAP_SEARCH_DN=DC=your-domain,DC=local

# Email Configuration (if needed)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME="BSJ Procurement Alerts"

# Email Encryption (optional)
# EMAIL_ENCRYPTION_KEY=generate-a-64-char-hex-key

# Feature Flags
ENABLE_INNOVATION_HUB=true
ENABLE_PROCUREMENT=true
